<html metal:use-macro="load: ./layout.pt" tal:define="scripts scripts|scripts">

<div metal:fill-slot="content">

<style>
.center-wrapper {
    display: flex;
    justify-content:auto; 
    align-items: center;
    min-height: 20vh;
}

/* Panel transparan efek kaca */
.panel {
    background: rgba(255, 255, 255, 0.2); 
    backdrop-filter: blur(10px);
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    width: 700px;
    padding: 20px;
}
body {
    background: transparent !important;
}
</style>

<div class="center-wrapper">
    <div class="panel">
        <div tal:content="structure form"></div>
    </div>
</div>

</div>
</html>
